# ── Database (MySQL 8) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=kavalo

# ── Admin auth ─────────────────────────────────────────────────────
# Single-admin password used by /api/login and the admin UI.
ADMIN_PASSWORD=changeme
# Secret used to HMAC-sign the session cookie (use a long random string).
SESSION_SECRET=please-change-this-to-a-long-random-string

# ── Site ───────────────────────────────────────────────────────────
SITE_URL=https://kavalo.top

# ── Runtime ────────────────────────────────────────────────────────
PORT=4321
NODE_ENV=development
