---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: unknown;
  aiAssisted?: boolean;
  aiProvider?: string;
  affiliate?: boolean;
  contentId?: string;
}
const {
  title = SITE.title,
  description = SITE.description,
  image = '/images/og-default.webp',
  jsonLd,
  aiAssisted = false,
  aiProvider = '',
  affiliate = false,
  contentId,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {/* §7.4 隐式标识：仅当 AI 辅助为 true 时输出 meta 信号（缺省 false，保守不误标） */}
    {aiAssisted === true && <meta name="ai-assisted" content="true" />}
    {/* §7.4 隐式标识完整性：服务提供者名称/编码 + 内容编号，与文章页 JSON-LD 扩展一致（安守正 G1-4 可选增强） */}
    {aiProvider && <meta name="ai-provider" content={aiProvider} />}
    {aiProvider && contentId && <meta name="ai-content-id" content={contentId} />}
    <link rel="preconnect" href="https://stats.kavalo.top" crossorigin />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <script
      is:inline
      defer
      src="https://stats.kavalo.top/script.js"
      data-website-id="9369a92f-aff3-4ef1-a645-0d38faf3e1ae"
    ></script>
    {jsonLd !== undefined && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
